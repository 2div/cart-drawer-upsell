# Shopify app credentials.
# Do not put real secrets in this example file.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=

# Keep this aligned with shopify.app.toml.
SCOPES=read_products

# Optional: allow auth for a custom shop domain during development.
SHOP_CUSTOM_DOMAIN=

# React Router / Node environment.
NODE_ENV=development
