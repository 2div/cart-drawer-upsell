# Shopify app credentials.
# Do not put real secrets in this example file.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=

# Keep this aligned with shopify.app.toml.
SCOPES=read_products

# Optional: allow auth for a custom shop domain during development.
SHOP_CUSTOM_DOMAIN=

# Billing is disabled by default until pricing and trial terms are final.
BILLING_ENABLED=false
BILLING_PLAN_NAME="Cart Drawer Upsell"
BILLING_MONTHLY_PRICE=0
BILLING_CURRENCY_CODE=USD
BILLING_TRIAL_DAYS=10
BILLING_TEST_MODE=true

# React Router / Node environment.
NODE_ENV=development
