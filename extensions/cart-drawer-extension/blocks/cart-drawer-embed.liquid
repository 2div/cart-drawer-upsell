{% assign cdu_upsell_config = app.metafields.cart_drawer_upsell.settings.value %}

<div
  class="cdu-cart-drawer"
  data-cdu-cart-drawer
  data-cdu-show-shipping-progress="{{ block.settings.show_shipping_progress }}"
  data-cdu-shipping-goal="{{ block.settings.shipping_goal }}"
  data-cdu-shipping-message="{{ block.settings.shipping_message | escape }}"
  data-cdu-shipping-success-message="{{ block.settings.shipping_success_message | escape }}"
  data-cdu-replace-native-drawer="{{ block.settings.replace_native_drawer }}"
  data-cdu-upsell-heading="{{ block.settings.upsell_heading | escape }}"
  data-cdu-upsell-limit="{{ block.settings.upsell_limit }}"
  data-cdu-upsell-add-label="{{ block.settings.upsell_add_label | escape }}"
  data-cdu-upsell-adding-label="{{ block.settings.upsell_adding_label | escape }}"
  data-cdu-upsell-added-label="{{ block.settings.upsell_added_label | escape }}"
  data-cdu-upsell-try-again-label="{{ block.settings.upsell_try_again_label | escape }}"
  data-cdu-upsell-sold-out-label="{{ block.settings.upsell_sold_out_label | escape }}"
  data-cdu-upsell-sold-out-message="{{ block.settings.upsell_sold_out_message | escape }}"
  data-cdu-upsell-already-sold-out-message="{{ block.settings.upsell_already_sold_out_message | escape }}"
  data-cdu-upsell-unavailable-message="{{ block.settings.upsell_unavailable_message | escape }}"
  data-cdu-upsell-add-error-message="{{ block.settings.upsell_add_error_message | escape }}"
  data-cdu-upsell-add-error-retry-message="{{ block.settings.upsell_add_error_retry_message | escape }}"
  data-cdu-empty-message="{{ block.settings.empty_message | escape }}"
  data-cdu-continue-shopping-label="{{ block.settings.continue_shopping_label | escape }}"
  data-cdu-loading-message="{{ block.settings.loading_message | escape }}"
  data-cdu-cart-load-error-message="{{ block.settings.cart_load_error_message | escape }}"
  data-cdu-cart-update-error-message="{{ block.settings.cart_update_error_message | escape }}"
  data-cdu-cart-sold-out-message="{{ block.settings.cart_sold_out_message | escape }}"
  data-cdu-item-added-message="{{ block.settings.item_added_message | escape }}"
  data-cdu-item-removed-message="{{ block.settings.item_removed_message | escape }}"
  data-cdu-quantity-updated-message="{{ block.settings.quantity_updated_message | escape }}"
  data-cdu-note-empty-message="{{ block.settings.note_empty_message | escape }}"
  data-cdu-note-success-message="{{ block.settings.note_success_message | escape }}"
  data-cdu-discount-empty-message="{{ block.settings.discount_empty_message | escape }}"
  data-cdu-discount-success-message="{{ block.settings.discount_success_message | escape }}"
  data-cdu-discount-failure-message="{{ block.settings.discount_failure_message | escape }}"
  style="
    --cdu-background: {{ block.settings.background_color }};
    --cdu-text: {{ block.settings.text_color }};
  "
>
  <button
    type="button"
    class="cdu-cart-drawer__launcher"
    data-cdu-open
    aria-controls="cdu-cart-panel-{{ block.id }}"
    aria-expanded="false"
    tabindex="-1"
    hidden
  >
    {{ block.settings.launcher_label }}
  </button>

  <script
    type="application/json"
    data-cdu-upsell-config
  >
    {% if cdu_upsell_config != blank %}
      {{ cdu_upsell_config | json | replace: '</script', '<\/script' }}
    {% else %}
      {"enabled":false,"products":[]}
    {% endif %}
  </script>

  <script
    src="{{ 'cart-drawer-compat.js' | asset_url }}"
    defer
  ></script>

  <script
    src="{{ 'cart-drawer-upsells.js' | asset_url }}"
    defer
  ></script>

  <div
    class="cdu-cart-drawer__overlay"
    data-cdu-overlay
  ></div>

  <aside
    id="cdu-cart-panel-{{ block.id }}"
    class="cdu-cart-drawer__panel"
    data-cdu-panel
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    aria-labelledby="cdu-cart-title-{{ block.id }}"
    tabindex="-1"
    inert
  >
    <header class="cdu-cart-drawer__header">
      <h2 id="cdu-cart-title-{{ block.id }}">
        {{ block.settings.heading }}
      </h2>

      <button
        type="button"
        class="cdu-cart-drawer__close"
        data-cdu-close
        aria-label="Close cart drawer"
      >
        &times;
      </button>
    </header>

    <div
      class="cdu-shipping-progress"
      data-cdu-shipping-progress
      hidden
    >
      <p
        class="cdu-shipping-progress__message"
        data-cdu-shipping-message
      ></p>

      <div
        class="cdu-shipping-progress__track"
        role="progressbar"
        aria-label="Free shipping progress"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        data-cdu-shipping-track
      >
        <span
          class="cdu-shipping-progress__bar"
          data-cdu-shipping-bar
        ></span>
      </div>
    </div>

    <div class="cdu-cart-drawer__body">
      <div
        class="cdu-cart-drawer__content"
        data-cdu-content
      >
        <p class="cdu-cart-drawer__loading">
          {{ block.settings.loading_message }}
        </p>
      </div>

      <div data-cdu-upsells></div>

      {% if block.settings.show_order_note %}
        <details class="cdu-cart-drawer__extra">
          <summary>{{ block.settings.note_label }}</summary>
          <div class="cdu-cart-drawer__field">
            <textarea
              data-cdu-note
              rows="3"
              aria-label="{{ block.settings.note_input_label }}"
            ></textarea>
            <button
              type="button"
              data-cdu-note-save
              data-cdu-action
            >
              {{ block.settings.note_button_label }}
            </button>
            <p data-cdu-note-message role="status"></p>
          </div>
        </details>
      {% endif %}

      {% if block.settings.show_discount_code %}
        <details class="cdu-cart-drawer__extra">
          <summary>{{ block.settings.discount_label }}</summary>
          <div class="cdu-cart-drawer__field">
            <input
              data-cdu-discount
              type="text"
              autocomplete="off"
              aria-label="{{ block.settings.discount_input_label }}"
            >
            <button
              type="button"
              data-cdu-discount-save
              data-cdu-action
            >
              {{ block.settings.discount_button_label }}
            </button>
            <p data-cdu-discount-message role="status"></p>
          </div>
        </details>
      {% endif %}
    </div>

    <p
      class="cdu-visually-hidden"
      data-cdu-status
      role="status"
      aria-live="polite"
    ></p>

    <footer
      class="cdu-cart-drawer__footer"
      data-cdu-footer
      hidden
    >
      <div class="cdu-cart-drawer__subtotal">
        <span>{{ block.settings.subtotal_label }}</span>
        <strong data-cdu-subtotal></strong>
      </div>

      <a
        class="cdu-cart-drawer__checkout"
        href="{{ routes.root_url }}checkout"
      >
        {{ block.settings.checkout_label }}
      </a>
    </footer>
  </aside>
</div>

{% schema %}
{
  "name": "Cart Drawer",
  "target": "body",
  "stylesheet": "cart-drawer.css",
  "javascript": "cart-drawer.js",
  "settings": [
    {
      "type": "checkbox",
      "id": "replace_native_drawer",
      "label": "Replace the theme cart drawer",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Drawer heading",
      "default": "Your cart"
    },
    {
      "type": "text",
      "id": "launcher_label",
      "label": "Test button label",
      "default": "Open cart"
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty cart message",
      "default": "Your cart is empty."
    },
    {
      "type": "text",
      "id": "continue_shopping_label",
      "label": "Continue shopping label",
      "default": "Continue shopping"
    },
    {
      "type": "text",
      "id": "subtotal_label",
      "label": "Subtotal label",
      "default": "Subtotal"
    },
    {
      "type": "text",
      "id": "checkout_label",
      "label": "Checkout button label",
      "default": "Check out"
    },
    {
      "type": "text",
      "id": "loading_message",
      "label": "Loading cart message",
      "default": "Loading cart..."
    },
    {
      "type": "text",
      "id": "cart_load_error_message",
      "label": "Cart load error message",
      "default": "We could not load your cart. Please try again."
    },
    {
      "type": "text",
      "id": "cart_update_error_message",
      "label": "Cart update error message",
      "default": "The cart could not be updated."
    },
    {
      "type": "text",
      "id": "cart_sold_out_message",
      "label": "Cart sold-out message",
      "default": "Sold out."
    },
    {
      "type": "text",
      "id": "item_added_message",
      "label": "Item added message",
      "default": "Item added to the cart."
    },
    {
      "type": "text",
      "id": "item_removed_message",
      "label": "Item removed message",
      "default": "Item removed from the cart."
    },
    {
      "type": "text",
      "id": "quantity_updated_message",
      "label": "Quantity updated message",
      "default": "Cart quantity updated."
    },
    {
      "type": "checkbox",
      "id": "show_shipping_progress",
      "label": "Show free shipping progress",
      "default": true
    },
    {
      "type": "number",
      "id": "shipping_goal",
      "label": "Free shipping goal",
      "default": 100
    },
    {
      "type": "text",
      "id": "shipping_message",
      "label": "Progress message",
      "default": "You are [amount] away from free shipping"
    },
    {
      "type": "text",
      "id": "shipping_success_message",
      "label": "Success message",
      "default": "You have unlocked free shipping!"
    },
    {
      "type": "text",
      "id": "upsell_heading",
      "label": "Upsell heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "upsell_limit",
      "label": "Upsells shown",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "upsell_add_label",
      "label": "Upsell add button label",
      "default": "Add"
    },
    {
      "type": "text",
      "id": "upsell_adding_label",
      "label": "Upsell adding button label",
      "default": "Adding..."
    },
    {
      "type": "text",
      "id": "upsell_added_label",
      "label": "Upsell added button label",
      "default": "Added"
    },
    {
      "type": "text",
      "id": "upsell_try_again_label",
      "label": "Upsell retry button label",
      "default": "Try again"
    },
    {
      "type": "text",
      "id": "upsell_sold_out_label",
      "label": "Upsell sold-out button label",
      "default": "Sold out"
    },
    {
      "type": "text",
      "id": "upsell_sold_out_message",
      "label": "Upsell sold-out message",
      "default": "This item is sold out."
    },
    {
      "type": "text",
      "id": "upsell_already_sold_out_message",
      "label": "Upsell already sold-out message",
      "default": "This item is already sold out."
    },
    {
      "type": "text",
      "id": "upsell_unavailable_message",
      "label": "Upsell unavailable message",
      "default": "This item is currently unavailable."
    },
    {
      "type": "text",
      "id": "upsell_add_error_message",
      "label": "Upsell add error message",
      "default": "This item could not be added."
    },
    {
      "type": "text",
      "id": "upsell_add_error_retry_message",
      "label": "Upsell retry error message",
      "default": "This item could not be added. Please try again."
    },
    {
      "type": "checkbox",
      "id": "show_order_note",
      "label": "Show order note",
      "default": true
    },
    {
      "type": "text",
      "id": "note_label",
      "label": "Order note heading",
      "default": "Add note"
    },
    {
      "type": "text",
      "id": "note_input_label",
      "label": "Order note input label",
      "default": "Order note"
    },
    {
      "type": "text",
      "id": "note_button_label",
      "label": "Order note button label",
      "default": "Save note"
    },
    {
      "type": "text",
      "id": "note_empty_message",
      "label": "Empty order note message",
      "default": "Enter an order note."
    },
    {
      "type": "text",
      "id": "note_success_message",
      "label": "Order note success message",
      "default": "Order note saved."
    },
    {
      "type": "checkbox",
      "id": "show_discount_code",
      "label": "Show discount code",
      "default": true
    },
    {
      "type": "text",
      "id": "discount_label",
      "label": "Discount heading",
      "default": "Add discount code"
    },
    {
      "type": "text",
      "id": "discount_input_label",
      "label": "Discount input label",
      "default": "Discount code"
    },
    {
      "type": "text",
      "id": "discount_button_label",
      "label": "Discount button label",
      "default": "Apply"
    },
    {
      "type": "text",
      "id": "discount_empty_message",
      "label": "Empty discount message",
      "default": "Enter a discount code."
    },
    {
      "type": "text",
      "id": "discount_success_message",
      "label": "Discount success message",
      "default": "Discount code applied."
    },
    {
      "type": "text",
      "id": "discount_failure_message",
      "label": "Discount failure message",
      "default": "Discount code was not applied."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#121212"
    }
  ]
}
{% endschema %}
