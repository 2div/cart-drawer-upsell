{% assign cdu_upsell_config = app.metafields.cart_drawer_upsell.settings.value %}

<div
  class="cdu-cart-drawer"
  data-cdu-cart-drawer
  data-cdu-show-shipping-progress="{{ block.settings.show_shipping_progress }}"
  data-cdu-shipping-goal="{{ block.settings.shipping_goal }}"
  data-cdu-shipping-message="{{ block.settings.shipping_message | escape }}"
  data-cdu-shipping-success-message="{{ block.settings.shipping_success_message | escape }}"
  data-cdu-replace-native-drawer="{{ block.settings.replace_native_drawer }}"
  data-cdu-upsell-heading="{{ block.settings.upsell_heading | escape }}"
  data-cdu-upsell-limit="{{ block.settings.upsell_limit }}"
  data-cdu-upsell-add-label="{{ block.settings.upsell_add_label | escape }}"
  data-cdu-upsell-adding-label="{{ block.settings.upsell_adding_label | escape }}"
  data-cdu-upsell-added-label="{{ block.settings.upsell_added_label | escape }}"
  data-cdu-upsell-try-again-label="{{ block.settings.upsell_try_again_label | escape }}"
  data-cdu-upsell-sold-out-label="{{ block.settings.upsell_sold_out_label | escape }}"
  data-cdu-upsell-sold-out-message="{{ block.settings.upsell_sold_out_message | escape }}"
  data-cdu-upsell-already-sold-out-message="{{ block.settings.upsell_already_sold_out_message | escape }}"
  data-cdu-upsell-unavailable-message="{{ block.settings.upsell_unavailable_message | escape }}"
  data-cdu-upsell-add-error-message="{{ block.settings.upsell_add_error_message | escape }}"
  data-cdu-upsell-add-error-retry-message="{{ block.settings.upsell_add_error_retry_message | escape }}"
  data-cdu-empty-message="{{ block.settings.empty_message | escape }}"
  data-cdu-continue-shopping-label="{{ block.settings.continue_shopping_label | escape }}"
  data-cdu-loading-message="{{ block.settings.loading_message | escape }}"
  data-cdu-cart-load-error-message="{{ block.settings.cart_load_error_message | escape }}"
  data-cdu-cart-update-error-message="{{ block.settings.cart_update_error_message | escape }}"
  data-cdu-cart-sold-out-message="{{ block.settings.cart_sold_out_message | escape }}"
  data-cdu-item-added-message="{{ block.settings.item_added_message | escape }}"
  data-cdu-item-removed-message="{{ block.settings.item_removed_message | escape }}"
  data-cdu-quantity-updated-message="{{ block.settings.quantity_updated_message | escape }}"
  data-cdu-product-fallback-label="{{ block.settings.product_fallback_label | escape }}"
  data-cdu-quantity-label="{{ block.settings.quantity_label | escape }}"
  data-cdu-decrease-label="{{ block.settings.decrease_label | escape }}"
  data-cdu-increase-label="{{ block.settings.increase_label | escape }}"
  data-cdu-remove-label="{{ block.settings.remove_label | escape }}"
  data-cdu-remove-title="{{ block.settings.remove_title | escape }}"
  data-cdu-note-empty-message="{{ block.settings.note_empty_message | escape }}"
  data-cdu-note-success-message="{{ block.settings.note_success_message | escape }}"
  data-cdu-discount-empty-message="{{ block.settings.discount_empty_message | escape }}"
  data-cdu-discount-success-message="{{ block.settings.discount_success_message | escape }}"
  data-cdu-discount-failure-message="{{ block.settings.discount_failure_message | escape }}"
  style="
    --cdu-background: {{ block.settings.background_color }};
    --cdu-text: {{ block.settings.text_color }};
    --cdu-button-background: {{ block.settings.button_background_color }};
    --cdu-button-text: {{ block.settings.button_text_color }};
    --cdu-progress-color: {{ block.settings.progress_color }};
  "
>
  <button
    type="button"
    class="cdu-cart-drawer__launcher"
    data-cdu-open
    aria-controls="cdu-cart-panel-{{ block.id }}"
    aria-expanded="false"
    tabindex="-1"
    hidden
  >
    {{ block.settings.launcher_label }}
  </button>

  <script
    type="application/json"
    data-cdu-upsell-config
  >
    {% if cdu_upsell_config != blank %}
      {{ cdu_upsell_config | json | replace: '</script', '<\/script' }}
    {% else %}
      {"enabled":false,"products":[]}
    {% endif %}
  </script>

  <script
    src="{{ 'cart-drawer-compat.js' | asset_url }}"
    defer
  ></script>

  <script
    src="{{ 'cart-drawer-upsells.js' | asset_url }}"
    defer
  ></script>

  <div
    class="cdu-cart-drawer__overlay"
    data-cdu-overlay
  ></div>

  <aside
    id="cdu-cart-panel-{{ block.id }}"
    class="cdu-cart-drawer__panel"
    data-cdu-panel
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    aria-labelledby="cdu-cart-title-{{ block.id }}"
    tabindex="-1"
    inert
  >
    <header class="cdu-cart-drawer__header">
      <h2 id="cdu-cart-title-{{ block.id }}">
        {{ block.settings.heading }}
      </h2>

      <button
        type="button"
        class="cdu-cart-drawer__close"
        data-cdu-close
        aria-label="{{ block.settings.close_label }}"
      >
        &times;
      </button>
    </header>

    <div
      class="cdu-shipping-progress"
      data-cdu-shipping-progress
      hidden
    >
      <p
        class="cdu-shipping-progress__message"
        data-cdu-shipping-message
      ></p>

      <div
        class="cdu-shipping-progress__track"
        role="progressbar"
        aria-label="{{ block.settings.shipping_progress_label }}"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        data-cdu-shipping-track
      >
        <span
          class="cdu-shipping-progress__bar"
          data-cdu-shipping-bar
        ></span>
      </div>
    </div>

    <div class="cdu-cart-drawer__body">
      <div
        class="cdu-cart-drawer__content"
        data-cdu-content
      >
        <p class="cdu-cart-drawer__loading">
          {{ block.settings.loading_message }}
        </p>
      </div>

      <div data-cdu-upsells></div>

      {% if block.settings.show_order_note %}
        <details class="cdu-cart-drawer__extra">
          <summary>{{ block.settings.note_label }}</summary>
          <div class="cdu-cart-drawer__field">
            <textarea
              data-cdu-note
              rows="3"
              aria-label="{{ block.settings.note_input_label }}"
            ></textarea>
            <button
              type="button"
              data-cdu-note-save
              data-cdu-action
            >
              {{ block.settings.note_button_label }}
            </button>
            <p data-cdu-note-message role="status"></p>
          </div>
        </details>
      {% endif %}

      {% if block.settings.show_discount_code %}
        <details class="cdu-cart-drawer__extra">
          <summary>{{ block.settings.discount_label }}</summary>
          <div class="cdu-cart-drawer__field">
            <input
              data-cdu-discount
              type="text"
              autocomplete="off"
              aria-label="{{ block.settings.discount_input_label }}"
            >
            <button
              type="button"
              data-cdu-discount-save
              data-cdu-action
            >
              {{ block.settings.discount_button_label }}
            </button>
            <p data-cdu-discount-message role="status"></p>
          </div>
        </details>
      {% endif %}
    </div>

    <p
      class="cdu-visually-hidden"
      data-cdu-status
      role="status"
      aria-live="polite"
    ></p>

    <footer
      class="cdu-cart-drawer__footer"
      data-cdu-footer
      hidden
    >
      <div class="cdu-cart-drawer__subtotal">
        <span>{{ block.settings.subtotal_label }}</span>
        <strong data-cdu-subtotal></strong>
      </div>

      <a
        class="cdu-cart-drawer__checkout"
        href="{{ routes.root_url }}checkout"
      >
        {{ block.settings.checkout_label }}
      </a>
    </footer>
  </aside>
</div>

